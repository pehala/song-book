# Template: `systemctl --user start songbook-web@<instance>` starts an instance; %i is its name. See docs/DEPLOY.md.
[Unit]
Description=Songbook web (gunicorn), instance %i
Requires=songbook-postgres@%i.service songbook-redis@%i.service
After=songbook-postgres@%i.service songbook-redis@%i.service

[Container]
ContainerName=songbook-web-%i
Image=ghcr.io/pehala/song-book:latest
# Only here: restarting web migrates first and restarts the worker through its Requires=
AutoUpdate=registry
# Makefile targets run by the image's make entrypoint: bring the database, the cache and nginx's
# static files up to date with this image, then serve on /run/gunicorn/gunicorn.sock
Exec=migrate prerender cache_clear export_static start
Network=none
EnvironmentFile=%h/.config/songbook/%i.env
Secret=songbook-secret-key-%i,type=env,target=SECRET_KEY
Secret=songbook-db-password-%i,type=env,target=POSTGRES_PASSWORD
Volume=%h/nginx/%i/gunicorn:/run/gunicorn:z
Volume=%t/songbook/%i/postgres:/run/postgresql:z
Volume=%t/songbook/%i/redis:/run/redis:z
Volume=%h/nginx/%i/media:/srv/media:z
Volume=%h/nginx/%i/static:/srv/static:z
# The image's user (UID 1001) is this host user, so everything it writes is owned by it
UserNS=keep-id:uid=1001,gid=1001
# make is the entrypoint; catatonit as PID 1 forwards SIGTERM so gunicorn/huey shut down gracefully
RunInit=true
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
# Healthy once gunicorn accepts connections, i.e. after the migrations; the worker waits for it.
# A stale socket from the previous run refuses connections, so it does not count.
HealthCmd=python -c "import socket; socket.socket(socket.AF_UNIX).connect('/run/gunicorn/gunicorn.sock')"
HealthInterval=30s
HealthStartupCmd=python -c "import socket; socket.socket(socket.AF_UNIX).connect('/run/gunicorn/gunicorn.sock')"
HealthStartupInterval=2s
Notify=healthy

[Service]
Restart=always
SuccessExitStatus=143
# Migrations run before the socket opens
TimeoutStartSec=900

[Install]
WantedBy=default.target
