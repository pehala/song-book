# Template of one songbook unit; %i is the instance name, started through songbook@<instance>.target. See deploy/DEPLOY.md.
[Unit]
PartOf=songbook@%i.target
Description=Songbook web (gunicorn), instance %i
Requires=songbook-redis@%i.service
After=songbook-redis@%i.service

[Container]
ContainerName=songbook-web-%i
Image=ghcr.io/pehala/song-book:latest
# Only here: restarting web migrates first and restarts the worker through its Requires=
AutoUpdate=registry
# Makefile targets run by the image's make entrypoint: bring the database, the cache and nginx's
# static files up to date with this image, then serve on /run/gunicorn/gunicorn.sock
Exec=migrate prerender cache_clear export_static start
Network=none
EnvironmentFile=%h/.config/songbook/%i.env
Secret=songbook-secret-key-%i,type=env,target=SECRET_KEY
Volume=%h/nginx/%i/gunicorn:/run/gunicorn:z
# The socket directory of the host's PostgreSQL, mounted without relabelling so that it keeps its labels
Volume=/run/postgresql:/run/postgresql
Volume=%t/songbook/%i/redis:/run/redis:z
Volume=%h/nginx/%i/media:/srv/media:z
Volume=%h/nginx/%i/static:/srv/static:z
# The image's user (UID 1001) is this host user, so everything it writes is owned by it
UserNS=keep-id:uid=1001,gid=1001
# make is the entrypoint; catatonit as PID 1 forwards SIGTERM so gunicorn/huey shut down gracefully
RunInit=true
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
# Healthy once gunicorn has created its socket, i.e. after the migrations; the worker waits for it.
# The socket of the previous run is removed before every start, so it does not count.
HealthCmd=test -S /run/gunicorn/gunicorn.sock
HealthInterval=30s
HealthStartupCmd=test -S /run/gunicorn/gunicorn.sock
HealthStartupInterval=2s
Notify=healthy

[Service]
# POSTGRES_PORT, the port in the name of PostgreSQL's socket, comes from the instance's env file
EnvironmentFile=-%h/.config/songbook/%i.env
ExecStartPre=-/bin/rm -f %h/nginx/%i/gunicorn/gunicorn.sock
# Wait for PostgreSQL, so that a boot where the user's units win the race does not burn through the restart limit
ExecStartPre=/bin/sh -c 'until test -S /run/postgresql/.s.PGSQL.$${POSTGRES_PORT:-5432}; do sleep 1; done'
Restart=always
SuccessExitStatus=143
# Migrations run before the socket opens, and the wait for PostgreSQL counts too
TimeoutStartSec=900

[Install]
WantedBy=default.target
