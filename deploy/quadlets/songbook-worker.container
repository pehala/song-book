[Unit]
Description=Songbook Huey worker (PDF generation)
# songbook-web is only ready after it has migrated the database
Requires=songbook-web.service songbook-postgres.service songbook-redis.service
After=songbook-web.service songbook-postgres.service songbook-redis.service

[Container]
ContainerName=songbook-worker
Image=ghcr.io/pehala/song-book:latest
Exec=worker
Network=none
EnvironmentFile=%h/.config/songbook/songbook.env
Secret=songbook-secret-key,type=env,target=SECRET_KEY
Secret=songbook-db-password,type=env,target=POSTGRES_PASSWORD
Volume=%t/songbook/postgres:/run/postgresql:z
Volume=%t/songbook/redis:/run/redis:z
Volume=%h/nginx/media:/srv/media:z
# The image's user (UID 1001) is this host user, so everything it writes is owned by it
UserNS=keep-id:uid=1001,gid=1001
# make is the entrypoint; catatonit as PID 1 forwards SIGTERM so gunicorn/huey shut down gracefully
RunInit=true
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
SuccessExitStatus=143

[Install]
WantedBy=default.target
