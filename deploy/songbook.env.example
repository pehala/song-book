# Install to ~/.config/songbook/<instance>.env (mode 0600), one file per instance. SECRET_KEY (and
# POSTGRES_PASSWORD, if the role has one) come from podman secrets, not from this file. The file is also read
# by systemd, so a value is written without quotes.

# Every tenant hostname must be listed, comma separated
ALLOWED_HOSTS=songs.example.org,camp.example.org
CSRF_TRUSTED_ORIGINS=https://songs.example.org,https://camp.example.org

# Hostname of the tenant created by the first migration
TENANT_HOSTNAME=songs.example.org
SITE_NAME=Songbook

# Read by gunicorn itself, overrides deploy/gunicorn.conf.py (2 workers x 4 threads)
#GUNICORN_CMD_ARGS=--workers 3 --threads 4

# PostgreSQL: the database of the instance, the role (the host user the units run as, with peer
# authentication) and the port in the socket's file name (.s.PGSQL.<port>), see deploy/DEPLOY.md
POSTGRES_DB=songbook_camp
#POSTGRES_USER=songbook
#POSTGRES_PORT=5432

# How the chords of a song are drawn: chords.markdown.RUBY_RENDERER (default, above the word) or
# chords.markdown.INLINE_RENDERER (in the line of text). web prerenders every song on start, so a change takes
# effect with a restart of the instance.
#SONG_RENDERER=chords.markdown.RUBY_RENDERER

# Name of the default tenant that the first migration creates (hostname: TENANT_HOSTNAME above)
#TENANT_NAME=Default

# Time zone of dates and times, a name of the tz database
#TIME_ZONE=UTC

# Seconds: a category's PDF is generated this long after its last edit, so that an editing spree makes one file
#CATEGORY_PDF_DELAY=1800
# Seconds: how long cached responses (the songs payload, menus) are kept; edits clear them at once
#CACHE_TIMEOUT=86400
# Seconds: how long a login lasts
#SESSION_COOKIE_AGE=86400

# Level of the logs of web and worker in the journal: DEBUG, INFO, WARNING, ERROR
#DJANGO_LOG_LEVEL=INFO
