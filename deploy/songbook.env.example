# Install to ~/.config/songbook/<instance>.env (mode 0600), one file per instance. SECRET_KEY and
# POSTGRES_PASSWORD come from podman secrets, not from this file.

# Every tenant hostname must be listed, comma separated
ALLOWED_HOSTS=songs.example.org,camp.example.org
CSRF_TRUSTED_ORIGINS=https://songs.example.org,https://camp.example.org

# Hostname of the tenant created by the first migration
TENANT_HOSTNAME=songs.example.org
SITE_NAME=Songbook

# Read by gunicorn itself, overrides deploy/gunicorn.conf.py (2 workers x 4 threads)
#GUNICORN_CMD_ARGS=--workers 3 --threads 4

# Shared PostgreSQL only (see docs/DEPLOY.md): database, role, and the port in the socket's file name
# (.s.PGSQL.<port>); the defaults are songbook, songbook and 5432
#POSTGRES_DB=songbook
#POSTGRES_USER=songbook
#POSTGRES_PORT=5432

# How the chords of a song are drawn: chords.markdown.INLINE_RENDERER (default, in the line of text) or
# chords.markdown.RUBY_RENDERER (above the word). web prerenders every song on start, so a change takes
# effect with a restart of the instance.
#SONG_RENDERER=chords.markdown.INLINE_RENDERER
